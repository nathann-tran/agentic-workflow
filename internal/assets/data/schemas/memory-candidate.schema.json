{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.dev/schemas/memory-candidate.schema.json",
  "title": "Persistent Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "workspace_id",
    "project_id",
    "category",
    "claim",
    "source_refs",
    "source_revision",
    "confidence",
    "proposed_action"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "category": {
      "enum": [
        "rule",
        "decision",
        "concept",
        "procedure",
        "gotcha",
        "session"
      ]
    },
    "claim": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "proposed_action": {
      "enum": [
        "create",
        "update",
        "supersede",
        "reject"
      ]
    },
    "duplicate_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval_required": {
      "type": "boolean"
    }
  }
}
