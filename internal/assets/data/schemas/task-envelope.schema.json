{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.dev/schemas/task-envelope.schema.json",
  "title": "Agentic Workflow Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "task_id",
    "caller_role",
    "assignee_role",
    "objective",
    "scope",
    "constraints",
    "context",
    "skills",
    "expected_result",
    "done_when"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "caller_role": {
      "enum": [
        "human",
        "conductor",
        "plan",
        "scout",
        "architect",
        "builder",
        "worker"
      ]
    },
    "assignee_role": {
      "enum": [
        "conductor",
        "plan",
        "scout",
        "architect",
        "builder",
        "worker"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "source_write_allowed": {
          "type": "boolean"
        },
        "network_allowed": {
          "type": "boolean"
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "max_delegation_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "external_mutation_allowed": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs",
        "approved_decision_refs",
        "memory_queries"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memory_queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "conditional",
        "explicit"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explicit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "include"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_summary_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_instruction": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
